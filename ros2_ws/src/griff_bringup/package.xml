<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>griff_bringup</name>
  <version>0.1.0</version>
  <description>
    Launch and configuration for the SO-101 force-limited manipulation stack.
  </description>
  <maintainer email="anjanas222001@gmail.com">Anjana Suresh</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>controller_manager</exec_depend>
  <exec_depend>griff_control</exec_depend>
  <exec_depend>griff_description</exec_depend>
  <exec_depend>griff_policy</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
