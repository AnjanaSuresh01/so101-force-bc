<?xml version="1.0"?>
<!--
  SO-101 follower arm.

  Link lengths, joint axes and limits are the same numbers as
  src/griff/assets/so101_arm.xml, and they have to stay that way: the MuJoCo
  model is what the policies were trained and evaluated against, and the URDF is
  what MoveIt and the admittance controller compute kinematics from. If the two
  drift apart, the controller's idea of where the tool is stops matching the
  robot the policy learned on, and the force-limit bound silently becomes a
  bound on the wrong point. tests/test_urdf_matches_mjcf.py checks them against
  each other, and CI runs it.

  Collision geometry is primitives, not vendor meshes. See the note in the MJCF.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="so101">

  <xacro:arg name="use_mock_hardware" default="true"/>
  <xacro:arg name="serial_port" default="/dev/ttyACM0"/>

  <!-- Link lengths, metres. Mirrors so101_arm.xml. -->
  <xacro:property name="shoulder_height" value="0.0542"/>
  <xacro:property name="shoulder_offset" value="0.0240"/>
  <xacro:property name="upper_arm_length" value="0.1159"/>
  <xacro:property name="forearm_length" value="0.1350"/>
  <xacro:property name="wrist_length" value="0.0400"/>
  <xacro:property name="wrist_roll_length" value="0.0140"/>
  <xacro:property name="tool_offset" value="0.0240"/>
  <xacro:property name="tool_centre_offset" value="0.0260"/>

  <!-- STS3215 at 12 V: 30 kgf.cm. -->
  <xacro:property name="servo_effort" value="2.94"/>
  <xacro:property name="servo_velocity" value="3.0"/>

  <xacro:macro name="segment" params="name length radius mass">
    <link name="${name}">
      <visual>
        <origin xyz="0 0 ${length / 2}" rpy="0 0 0"/>
        <geometry><cylinder radius="${radius}" length="${length}"/></geometry>
        <material name="graphite"><color rgba="0.25 0.27 0.31 1"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 ${length / 2}" rpy="0 0 0"/>
        <geometry><cylinder radius="${radius}" length="${length}"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 ${length / 2}" rpy="0 0 0"/>
        <mass value="${mass}"/>
        <inertia
          ixx="${mass * (3 * radius * radius + length * length) / 12}" ixy="0" ixz="0"
          iyy="${mass * (3 * radius * radius + length * length) / 12}" iyz="0"
          izz="${mass * radius * radius / 2}"/>
      </inertial>
    </link>
  </xacro:macro>

  <link name="world"/>
  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.018"/>
      <geometry><box size="0.09 0.09 0.036"/></geometry>
      <material name="steel"><color rgba="0.55 0.57 0.60 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0.018"/>
      <geometry><box size="0.09 0.09 0.036"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.018"/>
      <mass value="0.45"/>
      <inertia ixx="0.0006" ixy="0" ixz="0" iyy="0.0006" iyz="0" izz="0.0006"/>
    </inertial>
  </link>

  <xacro:segment name="shoulder_link" length="${shoulder_offset}" radius="0.018" mass="0.09"/>
  <joint name="shoulder_pan" type="revolute">
    <parent link="base_link"/>
    <child link="shoulder_link"/>
    <origin xyz="0 0 ${shoulder_height}" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.92" upper="1.92" effort="${servo_effort}" velocity="${servo_velocity}"/>
  </joint>

  <xacro:segment name="upper_arm_link" length="${upper_arm_length}" radius="0.017" mass="0.18"/>
  <joint name="shoulder_lift" type="revolute">
    <parent link="shoulder_link"/>
    <child link="upper_arm_link"/>
    <origin xyz="0 0 ${shoulder_offset}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.75" upper="1.75" effort="${servo_effort}" velocity="${servo_velocity}"/>
  </joint>

  <xacro:segment name="forearm_link" length="${forearm_length}" radius="0.015" mass="0.16"/>
  <joint name="elbow_flex" type="revolute">
    <parent link="upper_arm_link"/>
    <child link="forearm_link"/>
    <origin xyz="0 0 ${upper_arm_length}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.69" upper="1.69" effort="${servo_effort}" velocity="${servo_velocity}"/>
  </joint>

  <xacro:segment name="wrist_link" length="${wrist_length}" radius="0.014" mass="0.08"/>
  <joint name="wrist_flex" type="revolute">
    <parent link="forearm_link"/>
    <child link="wrist_link"/>
    <origin xyz="0 0 ${forearm_length}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <!-- +/- 110 deg. See the wrist_flex comment in so101_arm.xml: at +/- 100 the
         arm cannot hold the tool vertical over the fixtures at all. -->
    <limit lower="-1.92" upper="1.92" effort="${servo_effort}" velocity="${servo_velocity}"/>
  </joint>

  <xacro:segment name="wrist_roll_link" length="${wrist_roll_length}" radius="0.013" mass="0.04"/>
  <joint name="wrist_roll" type="revolute">
    <parent link="wrist_link"/>
    <child link="wrist_roll_link"/>
    <origin xyz="0 0 ${wrist_length}" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.79" upper="2.79" effort="${servo_effort}" velocity="${servo_velocity}"/>
  </joint>

  <link name="tool_link">
    <visual>
      <geometry><box size="0.028 0.020 0.020"/></geometry>
      <material name="steel"/>
    </visual>
    <collision><geometry><box size="0.028 0.020 0.020"/></geometry></collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="4e-5" ixy="0" ixz="0" iyy="4e-5" iyz="0" izz="4e-5"/>
    </inertial>
  </link>
  <joint name="tool_mount" type="fixed">
    <parent link="wrist_roll_link"/>
    <child link="tool_link"/>
    <origin xyz="0 0 ${tool_offset}" rpy="0 0 0"/>
  </joint>

  <!-- The point the admittance controller regulates, and the point the force
       estimate is expressed at. MoveIt's tip link. -->
  <link name="tool_centre"/>
  <joint name="tool_centre_joint" type="fixed">
    <parent link="tool_link"/>
    <child link="tool_centre"/>
    <origin xyz="0 0 ${tool_centre_offset}" rpy="0 0 0"/>
  </joint>

  <link name="gripper_jaw">
    <visual>
      <origin xyz="0 0 0.020"/>
      <geometry><box size="0.008 0.018 0.040"/></geometry>
      <material name="steel"/>
    </visual>
    <inertial>
      <origin xyz="0 0 0.020"/>
      <mass value="0.01"/>
      <inertia ixx="2e-6" ixy="0" ixz="0" iyy="2e-6" iyz="0" izz="2e-6"/>
    </inertial>
  </link>
  <joint name="gripper" type="prismatic">
    <parent link="tool_link"/>
    <child link="gripper_jaw"/>
    <origin xyz="-0.011 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.004" upper="0.020" effort="25.0" velocity="0.15"/>
  </joint>

  <ros2_control name="so101_hardware" type="system">
    <hardware>
      <xacro:if value="$(arg use_mock_hardware)">
        <plugin>mock_components/GenericSystem</plugin>
        <param name="calculate_dynamics">true</param>
      </xacro:if>
      <xacro:unless value="$(arg use_mock_hardware)">
        <!--
          There is no hardware interface package in this repo. Driving a real
          SO-101 from ros2_control needs a SystemInterface wrapping the Feetech
          bus; griff.teleop.feetech implements that protocol in Python, but it
          has never been run against a servo, and no C++ port of it exists.
          Naming a plugin here that does not exist would make this file look
          like it can do something it cannot.
        -->
        <plugin>griff_hardware/NotImplemented</plugin>
        <param name="serial_port">$(arg serial_port)</param>
      </xacro:unless>
    </hardware>

    <xacro:macro name="servo_joint" params="name min max">
      <joint name="${name}">
        <command_interface name="position">
          <param name="min">${min}</param>
          <param name="max">${max}</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <!-- STS3215 present-load. This is the only force-related quantity the
             hardware exposes, and it is what the force estimate is built on. -->
        <state_interface name="effort"/>
      </joint>
    </xacro:macro>

    <xacro:servo_joint name="shoulder_pan" min="-1.92" max="1.92"/>
    <xacro:servo_joint name="shoulder_lift" min="-1.75" max="1.75"/>
    <xacro:servo_joint name="elbow_flex" min="-1.69" max="1.69"/>
    <xacro:servo_joint name="wrist_flex" min="-1.92" max="1.92"/>
    <xacro:servo_joint name="wrist_roll" min="-2.79" max="2.79"/>
    <xacro:servo_joint name="gripper" min="-0.004" max="0.020"/>
  </ros2_control>
</robot>
